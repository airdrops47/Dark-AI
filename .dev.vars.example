# Copy to .dev.vars for local use. .dev.vars is gitignored.
# For GitHub Actions, add the same names under
# Settings -> Secrets and variables -> Actions -> New repository secret.

# Required only by agent-run.yml (headless agent runs).
# It is the credential the OpenCode CLI uses for the provider named in opencode.json.
OPENCODE_API_KEY=

# Optional: provider keys for third-party model access.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPINFRA_API_KEY=
# TOGETHER_API_KEY=

# Optional: model override for CI runs, e.g. opencode/cat-jam-free
OPENCODE_MODEL=
